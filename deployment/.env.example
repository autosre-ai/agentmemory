# Agent Memory Toolkit - Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================
# Server Configuration
# ============================================
AMT_PORT=8000
AMT_WORKERS=4
AMT_DEBUG=false
AMT_LOG_LEVEL=info

# ============================================
# Authentication (REQUIRED - Change these!)
# ============================================
# JWT secret key - MUST be set to a secure random value in production
# Generate with: openssl rand -base64 32
AMT_JWT_SECRET=your-secure-jwt-secret-key-here

# JWT token expiration in minutes
AMT_JWT_EXPIRATION=60

# Default user passwords (change in production!)
AMT_ADMIN_PASSWORD=admin
AMT_AGENT_PASSWORD=agent

# ============================================
# Rate Limiting
# ============================================
AMT_RATE_LIMIT=true
AMT_RATE_LIMIT_REQUESTS=100
AMT_RATE_LIMIT_WINDOW=60

# ============================================
# Redis Cache
# ============================================
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
AMT_CACHE_TTL=3600

# ============================================
# Resource Limits
# ============================================
# API Server
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2G
API_CPU_RESERVE=0.5
API_MEMORY_RESERVE=512M

# Redis
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_RESERVE=0.1
REDIS_MEMORY_RESERVE=128M

# ============================================
# Optional Services
# ============================================
# Redis Commander (admin profile)
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin

# Prometheus (monitoring profile)
PROMETHEUS_PORT=9090

# Grafana (monitoring profile)
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
